const CACHE_NAME = 'dinh-truong-app-v3';
const urlsToCache = [
  './index.html',
  './manifest.json'
];

self.addEventListener('install', event => {
  event.waitUntil(
    caches.open(CACHE_NAME)
      .then(cache => {
        return cache.addAll(urlsToCache);
      })
  );
});

self.addEventListener('fetch', event => {
  event.respondWith(
    caches.match(event.request)
      .then(response => {
        // Trả về dữ liệu từ cache nếu có, ngược lại thì gọi mạng
        return response || fetch(event.request);
      })
  );
});
